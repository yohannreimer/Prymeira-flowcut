FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY packages/auth/package.json packages/auth/package.json
RUN npm ci

COPY packages/auth packages/auth
COPY tsconfig.json vite.config.ts index.html ./
COPY src src
RUN npm run build:server

FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache chromium ffmpeg nss freetype harfbuzz ca-certificates ttf-freefont

COPY package*.json ./
COPY packages/auth/package.json packages/auth/package.json
RUN npm ci --omit=dev

COPY --from=build /app/dist/server dist/server
COPY --from=build /app/packages/auth/dist packages/auth/dist
COPY src/remotion src/remotion
COPY src/shared src/shared
RUN addgroup -S appgroup \
  && adduser -S appuser -G appgroup \
  && mkdir -p /app/workspace /tmp/ai-editor-uploads \
  && chown -R appuser:appgroup /app /tmp/ai-editor-uploads

ENV NODE_ENV=production
ENV PORT=4317
ENV AI_EDITOR_WORKSPACE=/app/workspace
ENV AI_EDITOR_PROJECT_RETENTION_MINUTES=30
ENV FFMPEG_PATH=ffmpeg
ENV FFPROBE_PATH=ffprobe
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

EXPOSE 4317

USER appuser

CMD ["node", "dist/server/index.js"]
