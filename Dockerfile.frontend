FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY packages/auth/package.json packages/auth/package.json
RUN npm ci

COPY packages/auth packages/auth
COPY tsconfig.json vite.config.ts index.html ./
COPY src src
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

USER root
RUN apk add --no-cache jq

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.d/40-prymeira-runtime-config.sh /docker-entrypoint.d/40-prymeira-runtime-config.sh
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-prymeira-runtime-config.sh \
  && chown -R 101:101 /usr/share/nginx/html /docker-entrypoint.d /etc/nginx/conf.d

USER 101

EXPOSE 8080
